{
  "name": "remotion-janonify",
  "version": "1.0.0",
  "private": true,
  "description": "Professional Motion Graphics Video Template with Remotion for Janonify (Default 9:16, customizable for 16:9 and 1:1)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Main-9-16 out/video-9-16.mp4 --port=3050",
    "render:landscape": "remotion render src/index.ts Main-16-9 out/video-16-9.mp4 --port=3050",
    "render:square": "remotion render src/index.ts Main-1-1 out/video-1-1.mp4 --port=3050",
    "render:still": "remotion still src/index.ts Main-9-16 out/preview.jpg --frame=120 --port=3050"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
